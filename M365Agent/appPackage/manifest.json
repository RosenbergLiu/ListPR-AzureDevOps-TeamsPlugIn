{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
    "manifestVersion": "1.25",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Teams App, Inc.",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termsofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Azure DevOps PRs${{APP_NAME_SUFFIX}}",
        "full": "Azure DevOps Active Pull Requests"
    },
    "description": {
        "short": "View and track active Azure DevOps pull requests",
        "full": "A Microsoft Teams tab application to authenticate and view active pull requests across your Azure DevOps projects."
    },
    "accentColor": "#5B5FC7",
    "supportsChannelFeatures": "tier1",
    "bots": [],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [
        {
            "entityId": "index",
            "name": "Pull Requests",
            "contentUrl": "${{TAB_ENDPOINT}}/tabs/test",
            "websiteUrl": "${{TAB_ENDPOINT}}/tabs/test",
            "scopes": [
                "personal",
                "groupChat",
                "team"
            ]
        }
    ],
    "permissions": [
        "identity"
    ],
    "validDomains": [
        "${{TAB_DOMAIN}}",
        "login.microsoftonline.com",
        "dev.azure.com",
        "app.vssps.visualstudio.com"
    ]
}